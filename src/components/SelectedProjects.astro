---
import { getCollection } from 'astro:content';
import { t, type Lang } from '../i18n/translations';
import { withBase } from '../utils/paths';
import { parsePeriod } from '../utils/projects';

interface Props {
  lang: Lang;
  showViewAll?: boolean;
}

const { lang, showViewAll = false } = Astro.props;
const tr = t(lang);

const allProjects = await getCollection('projects');
const enFeatured = allProjects
  .filter(e => e.id.startsWith('en/') && e.data.pinnedToTop)
  .sort((a, b) => parsePeriod(b.data.period) - parsePeriod(a.data.period));

const selectedProjects = enFeatured.map(enEntry => {
  const projectId = enEntry.id.replace('en/', '');
  const langEntry = allProjects.find(e => e.id === `${lang}/${projectId}` && e.body?.trim());
  return langEntry ?? enEntry;
});
---

<section class="max-w-4xl mx-auto px-6 py-16 border-t border-[var(--color-border)]">

  <h2 class="text-xs tracking-[0.2em] uppercase mb-12 text-[var(--color-accent)] font-sans fade-up">
    {tr.projects.selected}
  </h2>

  <div class="space-y-16">
    {selectedProjects.map((project, i) => (
      <article class="fade-up pt-12 border-t border-[var(--color-border)]" style={`animation-delay: ${0.1 * (i + 1)}s`}>
        <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4 mb-6">
          <div class="flex flex-wrap items-center gap-4">
            <a href={withBase(`/${lang}/projects/${project.data.id}`)}
               class="font-display text-[clamp(1.5rem,5vw,2.25rem)] font-medium text-[var(--color-text)] no-underline transition-colors duration-300 hover:text-[var(--color-accent)]">
              {project.data.title}
            </a>
            {project.data.wip && (
              <span class="text-[10px] px-2 py-0.5 tracking-widest uppercase border border-[var(--color-accent)] text-[var(--color-accent)]">
                {tr.projects.wip}
              </span>
            )}
          </div>

          <div class="flex flex-col items-start md:items-end gap-3 shrink-0">
            {project.data.period && (
              <span class="text-xs tracking-[0.15em] uppercase text-[var(--color-muted)]">
                {project.data.period}
              </span>
            )}
            <div class="flex items-center gap-6">
              {project.data.demo && (
                <a href={project.data.demo}
                   target="_blank"
                   rel="noopener noreferrer"
                   class="group inline-flex items-center gap-1.5 text-xs tracking-[0.15em] uppercase no-underline text-[var(--color-muted)] transition-colors duration-200 hover:text-[var(--color-text)]">
                  {tr.projects.demo}
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5">
                    <path d="M7 17L17 7M7 7h10v10"/>
                  </svg>
                </a>
              )}
              {project.data.repo && (
                <a href={project.data.repo}
                   target="_blank"
                   rel="noopener noreferrer"
                   class="group inline-flex items-center gap-1.5 text-xs tracking-[0.15em] uppercase no-underline text-[var(--color-muted)] transition-colors duration-200 hover:text-[var(--color-text)]">
                  {tr.projects.code}
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5">
                    <path d="M7 17L17 7M7 7h10v10"/>
                  </svg>
                </a>
              )}
            </div>
          </div>
        </div>

        <p class="text-lg leading-relaxed text-[var(--color-muted)] font-serif italic mb-8 max-w-2xl">
          {project.data.homeDescription ?? project.data.description}
        </p>

        <div class="flex flex-wrap gap-2">
          {project.data.tags.map(tag => (
            <span class="text-[10px] px-2 py-0.5 tracking-[0.15em] uppercase bg-[var(--color-border)] text-[var(--color-muted)]">
              {tag}
            </span>
          ))}
        </div>
      </article>
    ))}
  </div>

  {showViewAll && (
    <div class="mt-16">
      <a href={withBase(`/${lang}/projects`)}
         class="group inline-flex items-center gap-2 text-sm tracking-[0.15em] uppercase no-underline text-[var(--color-accent)] font-medium transition-colors duration-200 hover:text-[var(--color-text)]">
        {tr.resume.viewAll}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="transition-transform duration-300 group-hover:translate-x-1">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  )}

</section>
